{
  "schema": 1,
  "id": "ocean-drive",
  "name": "Ocean Drive",
  "author": "notchi community",
  "version": "1.0.0",
  "appearance": "dark",
  "accent": "#3FA9F5",
  "glass": {
    "blur": 0.75,
    "tint": 0.25
  },
  "wallpaper": {
    "type": "video",
    "src": "ocean.mp4",
    "fps": 30
  },
  "icons": {
    "pack": "default",
    "tintFolders": true
  },
  "notch": {
    "glow": "accent",
    "idle": "breathing",
    "visualizer": true
  },
  "sidebar": {
    "widgets": [
      "nowPlaying",
      "calendar",
      "stats"
    ]
  },
  "dock": {
    "style": "floating-glass",
    "magnify": 1.4
  },
  "menuBar": {
    "tint": "accent",
    "opacity": 0.4
  },
  "sounds": {
    "pack": "soft-synth"
  },
  "cursor": {
    "trail": "comet"
  }
}
