{
  "schema": 1,
  "id": "matcha",
  "name": "Matcha",
  "author": "notchi",
  "version": "1.0.0",
  "appearance": "light",
  "accent": "#4F9A3A",
  "glass": {
    "blur": 0.7,
    "tint": 0.2
  },
  "wallpaper": {
    "type": "shader",
    "src": "leaf-drift.metal",
    "fps": 30
  },
  "icons": {
    "pack": "default",
    "tintFolders": true
  },
  "notch": {
    "glow": "accent",
    "idle": "breathing",
    "visualizer": true
  },
  "sidebar": {
    "widgets": [
      "nowPlaying",
      "calendar",
      "stats"
    ]
  },
  "dock": {
    "style": "centered-pill",
    "magnify": 1.4
  },
  "menuBar": {
    "tint": "accent",
    "opacity": 0.4
  },
  "sounds": {
    "pack": "wood-tap"
  },
  "cursor": {
    "trail": "leaf"
  }
}
