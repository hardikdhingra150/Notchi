{
  "schema": 1,
  "id": "neon-rain",
  "name": "Neon Rain",
  "author": "notchi",
  "version": "1.0.0",
  "appearance": "dark",
  "accent": "#FF3FD8",
  "glass": {
    "blur": 0.8,
    "tint": 0.3
  },
  "wallpaper": {
    "type": "shader",
    "src": "rain.metal",
    "fps": 30
  },
  "icons": {
    "pack": "default",
    "tintFolders": true
  },
  "notch": {
    "glow": "accent",
    "idle": "rain",
    "visualizer": true
  },
  "sidebar": {
    "widgets": [
      "nowPlaying",
      "calendar",
      "stats"
    ]
  },
  "dock": {
    "style": "vertical",
    "magnify": 1.4
  },
  "menuBar": {
    "tint": "accent",
    "opacity": 0.4
  },
  "sounds": {
    "pack": "soft-synth"
  },
  "cursor": {
    "trail": "spark"
  }
}
